{
  "openapi": "3.0.3",
  "info": {
    "title": "Music Collection API",
    "version": "1.0.0",
    "description": "Лабораторная работа 2, вариант 9"
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Вход и установка session cookie",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Login" } } } },
        "responses": { "200": { "description": "Вход выполнен" }, "400": { "description": "Некорректный запрос" }, "401": { "description": "Неверные данные" }, "500": { "description": "Ошибка сервера" } }
      }
    },
    "/albums": {
      "get": { "summary": "Список альбомов", "responses": { "200": { "description": "OK" }, "304": { "description": "Not Modified" }, "401": { "description": "Unauthorized" } } },
      "post": { "summary": "Создать альбом", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlbumInput" } } } }, "responses": { "201": { "description": "Created" }, "400": { "description": "Bad Request" }, "401": { "description": "Unauthorized" }, "403": { "description": "Forbidden" } } }
    },
    "/albums/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "summary": "Получить альбом", "responses": { "200": { "description": "OK" }, "404": { "description": "Not Found" } } },
      "put": { "summary": "Заменить альбом", "responses": { "200": { "description": "OK" }, "400": { "description": "Bad Request" }, "403": { "description": "Forbidden" }, "404": { "description": "Not Found" } } },
      "patch": { "summary": "Изменить альбом", "responses": { "200": { "description": "OK" }, "400": { "description": "Bad Request" }, "403": { "description": "Forbidden" }, "404": { "description": "Not Found" } } },
      "delete": { "summary": "Удалить альбом", "responses": { "204": { "description": "No Content" }, "403": { "description": "Forbidden" }, "404": { "description": "Not Found" } } }
    },
    "/health": {
      "get": { "summary": "Проверка доступности", "responses": { "200": { "description": "OK" } } }
    }
  },
  "components": {
    "schemas": {
      "Login": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string" } } },
      "AlbumInput": { "type": "object", "required": ["performer", "album", "year", "genre"], "properties": { "performer": { "type": "string" }, "album": { "type": "string" }, "year": { "type": "integer", "minimum": 1800, "maximum": 2100 }, "genre": { "type": "string" } } }
    }
  }
}
